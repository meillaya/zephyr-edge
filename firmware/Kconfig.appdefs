# Kconfig.appdefs — application-level config symbols shared by the main app and
# the ztest suites. Contains only symbol definitions (no mainmenu, no
# `source "Kconfig.zephyr"`); the sourcing Kconfig file provides those.

config DEVICE_ID
	string "Device identifier"
	default "native-sim-001"
	help
	  Stable string identifier embedded in every telemetry payload
	  (telemetry map key 1). Fleet simulator devices use fleet-sim-<N>.

config SENSOR_LOG_BUF_SIZE
	int "Sensor log ring buffer size (bytes)"
	default 4096
	range 256 1048576
	help
	  Size in bytes of the ring buffer that stores timestamped BME280
	  readings before telemetry publication. Each record is
	  sizeof(struct sensor_reading) (20 bytes on 32-bit native_sim, 24 on
	  64-bit), so the 4096-byte default holds ~170-204 records depending on
	  target. Overflow overwrites the oldest record.

config POWER_ACTIVE_MS
	int "Power scheduler active window (ms)"
	default 5000
	range 1 3600000
	help
	  Duration of the active window each cycle: CPU runs, sensor is
	  sampled and logged.

config POWER_IDLE_MS
	int "Power scheduler idle window (ms)"
	default 100
	range 0 3600000
	help
	  Duration of the runtime-idle window between active and sleep.

config POWER_SLEEP_MS
	int "Power scheduler sleep window (ms)"
	default 55000
	range 0 3600000
	help
	  Duration of the suspend-to-idle sleep window each cycle. With the
	  defaults the device is active 5s then sleeps 55s (10% duty cycle).

config MQTT_BROKER_HOST
	string "MQTT broker IPv4 address"
	default "192.0.2.2"
	help
	  IPv4 address of the MQTT broker the telemetry publisher connects to.
	  The default (192.0.2.2) is the standard Zephyr native host-bridge
	  address used by net-setup.sh / the docker-compose e2e stack; override
	  it for a different network topology. native_sim reaches the host
	  broker through the TAP ethernet driver (CONFIG_ETH_NATIVE_POSIX), so
	  live publication requires host-side bridge setup (see infra/README.md).

config MQTT_BROKER_PORT
	int "MQTT broker port"
	default 1883
	range 1 65535
	help
	  TCP port of the MQTT broker. Default 1883 is the standard
	  unencrypted MQTT port (local dev/CI runs without TLS; documented
	  limitation).

config MQTT_TELEMETRY_TOPIC_FMT
	string "Telemetry topic format (printf-style, one %s = device_id)"
	default "devices/%s/telemetry"
	help
	  printf-style topic the telemetry publisher publishes to. The single
	  %s is replaced with CONFIG_DEVICE_ID, yielding e.g.
	  devices/native-sim-001/telemetry. The cloud ingestion service
	  subscribes to the matching wildcard (devices/+/telemetry).

config MQTT_CONNECT_TIMEOUT_MS
	int "MQTT connect timeout (ms)"
	default 5000
	range 100 60000
	help
	  How long telemetry_connect() waits for CONNACK before giving up and
	  returning -ETIMEDOUT. Connection is non-fatal: the application keeps
	  sampling/logging and retries on the next cycle.
