# Kconfig.appdefs — application-level config symbols shared by the main app and
# the ztest suites. Contains only symbol definitions (no mainmenu, no
# `source "Kconfig.zephyr"`); the sourcing Kconfig file provides those.

config DEVICE_ID
	string "Device identifier"
	default "native-sim-001"
	help
	  Stable string identifier embedded in every telemetry payload
	  (telemetry map key 1). Fleet simulator devices use fleet-sim-<N>.

config SENSOR_LOG_BUF_SIZE
	int "Sensor log ring buffer size (bytes)"
	default 4096
	range 256 1048576
	help
	  Size in bytes of the ring buffer that stores timestamped BME280
	  readings before telemetry publication. Each record is
	  sizeof(struct sensor_reading) (24 bytes on the default 64-bit
	  native_sim target), so the 4096-byte default holds ~170 records.
	  Overflow overwrites the oldest record.

config POWER_ACTIVE_MS
	int "Power scheduler active window (ms)"
	default 5000
	range 1 3600000
	help
	  Duration of the active window each cycle: CPU runs, sensor is
	  sampled and logged.

config POWER_IDLE_MS
	int "Power scheduler idle window (ms)"
	default 100
	range 0 3600000
	help
	  Duration of the runtime-idle window between active and sleep.

config POWER_SLEEP_MS
	int "Power scheduler sleep window (ms)"
	default 5000
	range 0 3600000
	help
	  Duration of the suspend-to-idle sleep window each cycle. With the
	  defaults the device is active 5s then sleeps 5s (about 50% duty
	  cycle). Longer sleep windows save power but reduce telemetry rate and
	  command responsiveness; the MQTT session is still serviced every
	  CONFIG_POWER_SERVICE_INTERVAL_MS during sleep.

config POWER_SERVICE_INTERVAL_MS
	int "Power scheduler service-callback interval (ms)"
	default 100
	range 10 5000
	help
	  During the sleep window the scheduler invokes the registered service
	  callback (telemetry_process) at this interval, so MQTT keepalive,
	  PUBACK, and OTA frames are handled without waiting for the next full
	  wake cycle.

config MQTT_BROKER_HOST
	string "MQTT broker IPv4 address"
	default "192.0.2.2"
	help
	  IPv4 address of the MQTT broker the telemetry publisher connects to.
	  The default (192.0.2.2) is the standard Zephyr native host-bridge
	  address used by net-setup.sh / the docker-compose e2e stack; override
	  it for a different network topology. native_sim reaches the host
	  broker through the TAP ethernet driver (CONFIG_ETH_NATIVE_POSIX), so
	  live publication requires host-side bridge setup (see infra/README.md).

config MQTT_BROKER_PORT
	int "MQTT broker port"
	default 8883 if MQTT_TLS
	default 1883
	range 1 65535
	help
	  TCP port of the MQTT broker. The default is 8883 with MQTT_TLS and
	  1883 for explicitly unencrypted builds.

config MQTT_TLS
	bool "MQTT over TLS"
	default y
	help
	  Connect with TLS using the embedded development CA certificate. The
	  broker certificate must chain to it and must match
	  MQTT_TLS_SERVER_NAME. Disable only for an isolated, explicitly
	  unencrypted test setup.

config MQTT_TLS_SERVER_NAME
	string "MQTT TLS server name (SNI/certificate verification)"
	default "broker"
	depends on MQTT_TLS
	help
	  Hostname presented in SNI and matched against the server certificate.
	  The committed dev certificate includes DNS:broker, DNS:mosquitto,
	  DNS:localhost, and the native_sim TAP addresses.

config MQTT_USERNAME
	string "MQTT username"
	default "edge-device"
	help
	  Username sent in CONNECT. Change for any real deployment; the
	  committed password file is development-only.

config MQTT_PASSWORD
	string "MQTT password"
	default "change-me"
	help
	  Password sent in CONNECT. The committed credentials are for the local
	  development stack only; use a secret for real deployments.

config MQTT_TELEMETRY_TOPIC_FMT
	string "Telemetry topic format (printf-style, one %s = device_id)"
	default "telemetry/%s"
	help
	  printf-style topic the telemetry publisher publishes to. The single
	  %s is replaced with CONFIG_DEVICE_ID, yielding e.g.
	  telemetry/native-sim-001. The cloud ingestion service
	  subscribes to the matching wildcard (telemetry/+).

config MQTT_CONNECT_TIMEOUT_MS
	int "MQTT connect timeout (ms)"
	default 5000
	range 100 60000
	help
	  How long telemetry_connect() waits for CONNACK before giving up and
	  returning -ETIMEDOUT. Connection is non-fatal: the application keeps
	  sampling/logging and retries on the next cycle.

config TELEMETRY_RX_PAYLOAD_MAX
	int "Maximum inbound PUBLISH payload read in one event (bytes)"
	default 600
	range 64 4096
	help
	  telemetry.c reads inbound PUBLISH payloads from the socket into a
	  fixed buffer before dispatching them to the registered handler (OTA).
	  Must be at least CONFIG_OTA_CHUNK_SIZE + 1 for OTA data frames; larger
	  payloads are drained and discarded with a warning.

# --- Phase 3: OTA ---

config OTA_CMD_TOPIC_FMT
	string "OTA command topic format (printf-style, one %s = device_id)"
	default "cmd/%s/ota"
	help
	  printf-style topic the OTA subscriber listens on for firmware update
	  frames. The single %s is replaced with CONFIG_DEVICE_ID, yielding
	  e.g. cmd/native-sim-001/ota (docs/DATA_MODEL.md §4). Frames are one
	  byte of opcode plus an optional big-endian size or raw image chunk;
	  see docs/OTA.md.

config OTA_MAX_IMAGE_SIZE
	int "Maximum OTA firmware image size (bytes)"
	default 262144
	range 4096 1048576
	help
	  Maximum size of a firmware image accepted via OTA. Images larger than
	  this are rejected before any flash writes begin.

config OTA_CHUNK_SIZE
	int "OTA flash write chunk size (bytes)"
	default 512
	range 64 4096
	help
	  Size of each chunk written to the flash simulator during OTA image
	  reception. Must be a multiple of the flash write block size.

# --- Phase 3: Fault injection ---

config FAULT_INJECT
	bool "Fault injection framework"
	default n
	help
	  Enable the fault injection framework. Individual fault modes are
	  gated by their own Kconfig symbols below. The main application keeps
	  this off by default; the fault_inject ztest suite enables it and all
	  modes. When disabled, all fault_inject_*() calls compile to no-ops.

config FAULT_INJECT_SENSOR_FAIL
	bool "Inject sensor read failures"
	default n
	depends on FAULT_INJECT
	help
	  When enabled, the application's sample path checks
	  fault_inject_sensor_check() before sensor_sample_fetch() and skips
	  the sample with -EIO, simulating a sensor hardware failure.

config FAULT_INJECT_FLASH_CORRUPT
	bool "Inject flash corruption"
	default n
	depends on FAULT_INJECT
	help
	  When enabled, OTA image bytes written to flash are inverted to
	  simulate flash media degradation (fault_inject_flash_corrupt_byte()
	  is applied in ota_write_chunk()).

config FAULT_INJECT_DROP_PACKETS
	bool "Inject MQTT packet drops"
	default n
	depends on FAULT_INJECT
	help
	  When enabled, the application's telemetry drain loop skips MQTT
	  publishes (the reading is still consumed) to simulate network packet
	  loss; the drop is logged and counted.
