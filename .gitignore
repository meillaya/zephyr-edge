# devenv / direnv caches
.devenv/
.direnv/

# west workspace: generated config + vendored modules cloned by `west update`.
# Anchored to the repo root so the in-repo driver module at
# firmware/drivers/zephyr/ (module.yml) is NOT ignored.
/.west/
/zephyr/
/modules/
/tools/
/bootloader/

# Zephyr / west build output (anywhere)
build/
**/build/
twister-out/
twister-out-*/

# Nix build symlink outputs
result
result-*

# Local editor / OS metadata
.idea/
.vscode/
*.swp
.DS_Store

# Sandboxed Podman VM state + generated verification artifacts
.sandbox/
artifacts/
power_report.md
# native_sim flash simulator backing file + devenv-generated hook file
/flash.bin
/.pre-commit-config.yaml

# Go build output (cloud/ + tests/ in later phases)
bin/
*.test

# Python / browser render caches
__pycache__/
*.pyc
docs/diagrams/.render-home/
